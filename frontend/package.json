{
  "name": "ai-crawler-desktop",
  "version": "0.1.0",
  "description": "AI 驱动的智能爬虫桌面应用",
  "author": "Shalabing",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:electron": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir tests/unit",
    "test:components": "vitest run --dir tests/components",
    "test:e2e": "playwright test",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win nsis msi",
    "dist:mac": "electron-vite build && electron-builder --mac dmg",
    "dist:linux": "electron-vite build && electron-builder --linux deb rpm",
    "dist:all": "electron-vite build && electron-builder -mwl"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "electron-log": "^5.2.0",
    "naive-ui": "^2.38.0",
    "pinia": "^2.2.0",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.7",
    "@playwright/test": "1.51.0",
    "@types/canvas-confetti": "^1.6.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^5.1.3",
    "@vue/test-utils": "^2.4.6",
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^24.1.0",
    "playwright": "1.51.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5",
    "vue-tsc": "^2.0.29"
  },
  "build": {
    "appId": "com.shalabing.ai-crawler",
    "productName": "AI 爬虫",
    "copyright": "Copyright © 2026 Shalabing",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "build/icons/**/*",
      "splash.html",
      "!**/node_modules/*/{*.mk,*.h,*.markdown,README.md,README,readme.md,readme,test,tests,docs,doc,example,examples}",
      "!**/node_modules/.cache",
      "!**/node_modules/**/*.ts",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI 爬虫"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 180
        },
        {
          "x": 410,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "category": "Development",
      "maintainer": "Shalabing"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret"
      ]
    }
  }
}
